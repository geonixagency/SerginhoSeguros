# Copie para .env.local (nunca commitar valores reais). Robô de portais (canal rpa).
ROBOT_PORT=8020
ROBOT_HOST=0.0.0.0
LOG_LEVEL=info
# Token compartilhado com a API (mesmo valor de PORTAL_ROBOT_TOKEN lá). openssl rand -hex 24
ROBOT_TOKEN=
# Pasta dos perfis persistentes (cookies de sessão dos portais). FORA do git.
ROBOT_PROFILE_DIR=./profiles
# false = abre janela do navegador (login manual assistido via noVNC/desktop).
ROBOT_HEADLESS=true
# Endereço do noVNC mostrado ao operador no login assistido (opcional).
ROBOT_VNC_URL=
# true = respostas incluem a ESTRUTURA (chaves/tipos, sem valores) do JSON do portal,
# para ajustar os mapeamentos com a sessão real sem expor dados de clientes.
ROBOT_DEBUG_SHAPES=false
# Ritmo humano e poucas execuções por dia (por seguradora). Acima do limite de logins,
# o robô devolve needs_human (login assistido); consultas acima do teto recebem 429.
ROBOT_MAX_LOGINS_PER_DAY=3
ROBOT_MAX_QUERIES_PER_DAY=300
ROBOT_STEP_MIN_MS=700
ROBOT_STEP_MAX_MS=2200
