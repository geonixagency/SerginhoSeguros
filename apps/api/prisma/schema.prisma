// Modelo de dados do SaaS Serginho Seguros (prompt pai §5).
// Convenções: models em inglês (código), campos em português (domínio);
// tabelas em snake_case via @@map; datas de calendário em @db.Date.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Perfil {
  ADMIN
  OPERADOR
}

enum ClientStatus {
  ATIVO
  INATIVO
}

enum FormaPagamento {
  BOLETO
  CARTAO
  DEBITO
  CARNE
  PIX
  OUTRO
}

enum PolicyStatus {
  VIGENTE
  VENCIDA
  CANCELADA
  RENOVADA
  EM_EMISSAO
}

enum InstallmentStatus {
  PENDENTE
  PAGO
  ATRASADO
  FALHOU
}

enum StatusIntegracao {
  SEM_API
  NAO_CONFIGURADA
  CONFIGURADA
  OK
  ERRO
}

enum InsurerCategoria {
  SEGURADORA
  PLATAFORMA
}

enum LeadEtapa {
  NOVO
  EM_CONTATO
  COTACAO_ENVIADA
  NEGOCIACAO
  FECHADO
  PERDIDO
}

enum QuoteStatus {
  PROCESSANDO
  CONCLUIDA
  ERRO
}

enum MessageStatus {
  AGENDADA
  ENVIANDO
  ENVIADA
  FALHOU
  CANCELADA
  IGNORADA
}

enum RuleGatilho {
  PRIMEIRA_PARCELA
  PROBLEMA_SEM_BOLETO
  PROBLEMA_COM_BOLETO
  ANIVERSARIO
}

enum DocumentTipo {
  APOLICE
  PROPOSTA
  ENDOSSO
  BOLETO
  OUTRO
}

enum TaskStatus {
  ABERTA
  CONCLUIDA
  CANCELADA
}

model User {
  id             String               @id @default(cuid())
  nome           String
  email          String               @unique
  senhaHash      String               @map("senha_hash")
  perfil         Perfil               @default(OPERADOR)
  ativo          Boolean              @default(true)
  ultimoLogin    DateTime?            @map("ultimo_login")
  /// Foto de perfil já recortada no navegador (data URL JPEG/WebP, ~256 px, até ~200 KB).
  avatar         String?              @db.Text
  createdAt      DateTime             @default(now()) @map("created_at")
  updatedAt      DateTime             @updatedAt @map("updated_at")
  refreshTokens  RefreshToken[]
  passwordResets PasswordResetToken[]
  leads          Lead[]
  auditLogs      AuditLog[]

  @@map("users")
}

/// Link de redefinição de senha: guardamos só o hash do token; uso único, expira em 1 h.
model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String    @map("user_id")
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")

  @@index([userId])
  @@map("password_reset_tokens")
}

/// Refresh tokens com rotação: guardamos só o hash; reuso de token revogado derruba a família.
model RefreshToken {
  id        String    @id @default(cuid())
  userId    String    @map("user_id")
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique @map("token_hash")
  familia   String
  expiresAt DateTime  @map("expires_at")
  revokedAt DateTime? @map("revoked_at")
  createdAt DateTime  @default(now()) @map("created_at")

  @@index([userId])
  @@index([familia])
  @@map("refresh_tokens")
}

model Client {
  id          String       @id @default(cuid())
  nome        String
  /// Só dígitos (11 = CPF, 14 = CNPJ).
  cpfCnpj     String       @map("cpf_cnpj")
  /// Pasta de origem na base do corretor: identifica o cliente na importação (o CPF pode repetir, ex.: esposa com apólice no CPF do marido).
  pasta       String?      @unique
  nascimento  DateTime?    @db.Date
  cnh         String?
  /// Só dígitos, DDD + número.
  telefone    String?
  email       String?
  endereco    Json?
  status      ClientStatus @default(INATIVO)
  origem      String?
  optOut      Boolean      @default(false) @map("opt_out")
  optOutEm    DateTime?    @map("opt_out_em")
  observacoes String?
  createdAt   DateTime     @default(now()) @map("created_at")
  updatedAt   DateTime     @updatedAt @map("updated_at")
  policies    Policy[]
  documents   Document[]
  messages    Message[]
  quotes      Quote[]
  leads       Lead[]
  tasks       Task[]

  @@index([cpfCnpj])
  @@index([nome])
  @@index([telefone])
  @@map("clients")
}

model Insurer {
  id               String             @id @default(cuid())
  nome             String             @unique
  slug             String             @unique
  categoria        InsurerCategoria   @default(SEGURADORA)
  ramos            String[]
  portalUrl        String?            @map("portal_url")
  temApi           Boolean            @default(false) @map("tem_api")
  statusIntegracao StatusIntegracao   @default(SEM_API) @map("status_integracao")
  /// Capacidades declaradas (cache do conector + notas da pesquisa de APIs).
  capacidades      Json               @default("[]")
  observacoes      String?
  ativo            Boolean            @default(true)
  createdAt        DateTime           @default(now()) @map("created_at")
  updatedAt        DateTime           @updatedAt @map("updated_at")
  credential       InsurerCredential?
  policies         Policy[]
  tasks            Task[]

  @@map("insurers")
}

/// Segredos de API das seguradoras/Aggilizador. Nunca saem do backend em claro.
model InsurerCredential {
  id                   String    @id @default(cuid())
  insurerId            String    @unique @map("insurer_id")
  insurer              Insurer   @relation(fields: [insurerId], references: [id], onDelete: Cascade)
  tipo                 String
  ambiente             String    @default("PRODUCAO")
  /// AES-256-GCM (formato v1:iv:tag:dados, base64) com APP_ENCRYPTION_KEY.
  segredoCriptografado String    @map("segredo_criptografado")
  /// Versão mascarada (para exibir sem decifrar).
  mascara              Json
  ultimoTeste          DateTime? @map("ultimo_teste")
  ultimoErro           String?   @map("ultimo_erro")
  createdAt            DateTime  @default(now()) @map("created_at")
  updatedAt            DateTime  @updatedAt @map("updated_at")

  @@map("insurer_credentials")
}

model Policy {
  id             String         @id @default(cuid())
  clientId       String         @map("client_id")
  client         Client         @relation(fields: [clientId], references: [id], onDelete: Cascade)
  insurerId      String         @map("insurer_id")
  insurer        Insurer        @relation(fields: [insurerId], references: [id])
  ramo           String
  numero         String?
  proposta       String?
  emissao        DateTime?      @db.Date
  inicioVigencia DateTime?      @map("inicio_vigencia") @db.Date
  fimVigencia    DateTime?      @map("fim_vigencia") @db.Date
  premioTotal    Decimal?       @map("premio_total") @db.Decimal(12, 2)
  formaPagamento FormaPagamento @default(OUTRO) @map("forma_pagamento")
  status         PolicyStatus   @default(VIGENTE)
  /// PDF principal da apólice.
  documentId     String?        @unique @map("document_id")
  document       Document?      @relation("PolicyMainDocument", fields: [documentId], references: [id], onDelete: SetNull)
  endossoDeId    String?        @map("endosso_de_id")
  endossoDe      Policy?        @relation("Endossos", fields: [endossoDeId], references: [id], onDelete: SetNull)
  endossos       Policy[]       @relation("Endossos")
  createdAt      DateTime       @default(now()) @map("created_at")
  updatedAt      DateTime       @updatedAt @map("updated_at")
  installments   Installment[]
  items          InsuredItem[]
  documents      Document[]     @relation("PolicyDocuments")

  @@index([clientId])
  @@index([insurerId])
  @@index([fimVigencia])
  @@index([numero])
  @@map("policies")
}

model Installment {
  id               String            @id @default(cuid())
  policyId         String            @map("policy_id")
  policy           Policy            @relation(fields: [policyId], references: [id], onDelete: Cascade)
  numero           Int
  valor            Decimal?          @db.Decimal(12, 2)
  vencimento       DateTime          @db.Date
  status           InstallmentStatus @default(PENDENTE)
  boletoDocumentId String?           @map("boleto_document_id")
  verificadoEm     DateTime?         @map("verificado_em")
  pagoEm           DateTime?         @map("pago_em")
  createdAt        DateTime          @default(now()) @map("created_at")
  updatedAt        DateTime          @updatedAt @map("updated_at")
  messages         Message[]

  @@unique([policyId, numero])
  @@index([vencimento, status])
  @@map("installments")
}

model InsuredItem {
  id        String  @id @default(cuid())
  policyId  String  @map("policy_id")
  policy    Policy  @relation(fields: [policyId], references: [id], onDelete: Cascade)
  /// VEICULO | IMOVEL | PESSOA | OUTRO
  tipo      String  @default("VEICULO")
  placa     String?
  modelo    String?
  ano       String?
  chassi    String?
  endereco  String?
  descricao String?

  @@index([placa])
  @@map("insured_items")
}

model Document {
  id          String       @id @default(cuid())
  clientId    String?      @map("client_id")
  client      Client?      @relation(fields: [clientId], references: [id], onDelete: Cascade)
  policyId    String?      @map("policy_id")
  policy      Policy?      @relation("PolicyDocuments", fields: [policyId], references: [id], onDelete: SetNull)
  tipo        DocumentTipo @default(APOLICE)
  nomeArquivo String       @map("nome_arquivo")
  /// Caminho RELATIVO a STORAGE_DIR (portável entre host Windows e container).
  caminho     String
  hash        String
  tamanho     Int          @default(0)
  mimeType    String       @default("application/pdf") @map("mime_type")
  extraido    Json?
  confianca   Json?
  createdAt   DateTime     @default(now()) @map("created_at")
  mainOf      Policy?      @relation("PolicyMainDocument")
  messages    Message[]

  @@index([hash])
  @@index([clientId])
  @@map("documents")
}

model Lead {
  id             String    @id @default(cuid())
  nome           String
  telefone       String?
  email          String?
  cpfCnpj        String?   @map("cpf_cnpj")
  produto        String?
  origem         String?
  etapa          LeadEtapa @default(NOVO)
  responsavelId  String?   @map("responsavel_id")
  responsavel    User?     @relation(fields: [responsavelId], references: [id], onDelete: SetNull)
  proximoContato DateTime? @map("proximo_contato")
  valorEstimado  Decimal?  @map("valor_estimado") @db.Decimal(12, 2)
  notas          String?
  motivoPerda    String?   @map("motivo_perda")
  clientId       String?   @map("client_id")
  client         Client?   @relation(fields: [clientId], references: [id], onDelete: SetNull)
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")
  quotes         Quote[]

  @@index([etapa])
  @@map("leads")
}

model Quote {
  id            String      @id @default(cuid())
  leadId        String?     @map("lead_id")
  lead          Lead?       @relation(fields: [leadId], references: [id], onDelete: Cascade)
  clientId      String?     @map("client_id")
  client        Client?     @relation(fields: [clientId], references: [id], onDelete: Cascade)
  ramo          String
  dados         Json        @default("{}")
  aggilizadorId String?     @map("aggilizador_id")
  status        QuoteStatus @default(PROCESSANDO)
  resultados    Json        @default("[]")
  erro          String?
  createdById   String?     @map("created_by_id")
  createdAt     DateTime    @default(now()) @map("created_at")
  updatedAt     DateTime    @updatedAt @map("updated_at")

  @@index([leadId])
  @@index([clientId])
  @@map("quotes")
}

model MessageTemplate {
  id           String        @id @default(cuid())
  nome         String        @unique
  conteudo     String
  gatilho      RuleGatilho?
  anexarBoleto Boolean       @default(false) @map("anexar_boleto")
  ativo        Boolean       @default(true)
  createdAt    DateTime      @default(now()) @map("created_at")
  updatedAt    DateTime      @updatedAt @map("updated_at")
  rules        MessageRule[]
  messages     Message[]

  @@map("message_templates")
}

model MessageRule {
  id               String           @id @default(cuid())
  nome             String
  gatilho          RuleGatilho
  templateId       String           @map("template_id")
  template         MessageTemplate  @relation(fields: [templateId], references: [id])
  /// Positivo = dias ANTES do vencimento; negativo = dias DEPOIS (D+1 = -1).
  antecedenciaDias Int              @default(0) @map("antecedencia_dias")
  /// HH:mm no fuso America/Sao_Paulo.
  horario          String           @default("09:00")
  formasPagamento  FormaPagamento[] @map("formas_pagamento")
  /// Slugs de seguradoras; vazio = todas.
  seguradoras      String[]
  ativo            Boolean          @default(true)
  ultimaExecucao   DateTime?        @map("ultima_execucao")
  createdAt        DateTime         @default(now()) @map("created_at")
  updatedAt        DateTime         @updatedAt @map("updated_at")
  messages         Message[]

  @@map("message_rules")
}

model Message {
  id              String           @id @default(cuid())
  clientId        String?          @map("client_id")
  client          Client?          @relation(fields: [clientId], references: [id], onDelete: SetNull)
  telefone        String
  conteudo        String
  status          MessageStatus    @default(AGENDADA)
  erro            String?
  ruleId          String?          @map("rule_id")
  rule            MessageRule?     @relation(fields: [ruleId], references: [id], onDelete: SetNull)
  installmentId   String?          @map("installment_id")
  installment     Installment?     @relation(fields: [installmentId], references: [id], onDelete: SetNull)
  templateId      String?          @map("template_id")
  template        MessageTemplate? @relation(fields: [templateId], references: [id], onDelete: SetNull)
  anexoDocumentId String?          @map("anexo_document_id")
  anexoDocument   Document?        @relation(fields: [anexoDocumentId], references: [id], onDelete: SetNull)
  broadcastId     String?          @map("broadcast_id")
  /// Chave de idempotência (ex.: "rule:<id>:inst:<id>" ou "rule:<id>:aniv:<cliente>:<ano>").
  dedupeKey       String?          @unique @map("dedupe_key")
  agendadaPara    DateTime         @default(now()) @map("agendada_para")
  enviadaEm       DateTime?        @map("enviada_em")
  evolutionId     String?          @map("evolution_id")
  tentativas      Int              @default(0)
  createdAt       DateTime         @default(now()) @map("created_at")
  updatedAt       DateTime         @updatedAt @map("updated_at")

  @@unique([ruleId, installmentId])
  @@index([status, agendadaPara])
  @@index([clientId])
  @@map("messages")
}

/// Configuração global de disparos (linha única id = 1).
model MessagingSettings {
  id              Int      @id @default(1)
  pausado         Boolean  @default(false)
  limiteDiario    Int      @default(200) @map("limite_diario")
  janelaInicio    Int      @default(8) @map("janela_inicio")
  janelaFim       Int      @default(20) @map("janela_fim")
  intervaloMinSeg Int      @default(20) @map("intervalo_min_seg")
  intervaloMaxSeg Int      @default(60) @map("intervalo_max_seg")
  updatedAt       DateTime @updatedAt @map("updated_at")

  @@map("messaging_settings")
}

/// Ação manual guiada (seguradora sem API): abre o portal e registra a tarefa.
model Task {
  id        String     @id @default(cuid())
  titulo    String
  descricao String?
  status    TaskStatus @default(ABERTA)
  clientId  String?    @map("client_id")
  client    Client?    @relation(fields: [clientId], references: [id], onDelete: Cascade)
  insurerId String?    @map("insurer_id")
  insurer   Insurer?   @relation(fields: [insurerId], references: [id], onDelete: SetNull)
  policyId  String?    @map("policy_id")
  createdBy String?    @map("created_by")
  createdAt DateTime   @default(now()) @map("created_at")
  updatedAt DateTime   @updatedAt @map("updated_at")

  @@index([status])
  @@map("tasks")
}

model AuditLog {
  id         String   @id @default(cuid())
  userId     String?  @map("user_id")
  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  acao       String
  entidade   String
  entidadeId String?  @map("entidade_id")
  antes      Json?
  depois     Json?
  ip         String?
  createdAt  DateTime @default(now()) @map("created_at")

  @@index([entidade, entidadeId])
  @@index([createdAt])
  @@map("audit_logs")
}
