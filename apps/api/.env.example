# Copie para .env.local (nunca commitar valores reais).
NODE_ENV=development
PORT=3333
LOG_LEVEL=info
DATABASE_URL=postgresql://serginho:troque@127.0.0.1:15432/serginho?schema=public
REDIS_URL=redis://127.0.0.1:16379
# openssl rand -base64 48
JWT_SECRET=
# 32 bytes: openssl rand -base64 32
APP_ENCRYPTION_KEY=
CORS_ORIGIN=http://localhost:3000
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
# Pasta raiz dos PDFs (importação e uploads). Caminhos no banco são relativos a ela.
STORAGE_DIR=./storage
PDF_PARSER_URL=http://127.0.0.1:8001
PDF_PARSER_TOKEN=
EVOLUTION_URL=
EVOLUTION_API_KEY=
EVOLUTION_INSTANCE=serginho-seguros
EVOLUTION_MOCK=true
EVOLUTION_WEBHOOK_TOKEN=
AGGILIZADOR_BASE_URL=
CONNECTORS_DEMO=false
# Serviço portal-robot (canal rpa: Tokio e Porto). Rede interna.
PORTAL_ROBOT_URL=http://127.0.0.1:8020
# Mesmo valor de ROBOT_TOKEN no portal-robot.
PORTAL_ROBOT_TOKEN=
RUN_WORKER=true
SEED_ADMIN_EMAIL=admin@serginhoseguros.com.br
# SEED_ADMIN_PASSWORD= (se vazio, o seed gera e grava aqui no .env.local)

# Link de redefinição de senha e e-mail (SMTP)
WEB_URL=http://localhost:3000
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
