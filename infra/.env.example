# Produção: copie para infra/.env (ignorado pelo git) e preencha.
POSTGRES_PASSWORD=
# openssl rand -base64 48
JWT_SECRET=
# openssl rand -base64 32  (NÃO perca: sem ela as credenciais das seguradoras ficam ilegíveis)
APP_ENCRYPTION_KEY=
API_DOMAIN=api.serginhoseguros.com.br
ACME_EMAIL=
CORS_ORIGIN=https://serginhoseguros.com.br,https://www.serginhoseguros.com.br
COOKIE_SAMESITE=none
PDF_PARSER_TOKEN=
EVOLUTION_URL=http://SEU_HOST:3000
EVOLUTION_API_KEY=
EVOLUTION_INSTANCE=serginho-seguros
EVOLUTION_MOCK=false
EVOLUTION_WEBHOOK_TOKEN=
AGGILIZADOR_BASE_URL=
CONNECTORS_DEMO=false
# Robô de portais (canal rpa). openssl rand -hex 24
PORTAL_ROBOT_TOKEN=
# Pasta no host com os perfis de navegador do robô (sessão dos portais). FORA do git.
ROBOT_PROFILE_HOST_DIR=/srv/serginho/robot-profiles
# true = headless; false para login assistido via noVNC.
ROBOT_HEADLESS=true
ROBOT_VNC_URL=
# Pasta no host com os PDFs (montada em /storage no container).
STORAGE_HOST_DIR=/srv/serginho/storage
SEED_ADMIN_EMAIL=admin@serginhoseguros.com.br
SEED_ADMIN_PASSWORD=
